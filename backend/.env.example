# ---------------------------------------------------------------------------
# Modèles locaux (Ollama)
# ---------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=120
MODEL_PLANNER=llama3.1:8b
MODEL_EXECUTOR=qwen2.5-coder:7b
MODEL_ANALYST=deepseek-r1:7b

# ---------------------------------------------------------------------------
# Navigateur / réseau
# ---------------------------------------------------------------------------
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_MS=30000
REQUEST_TIMEOUT_SECONDS=15
USER_AGENT=AITesterBot/1.0 (+https://example.tn/ai-tester)
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Base de données
# ---------------------------------------------------------------------------
# SQLite par défaut (MVP). Pour Postgres :
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/aitester
DATABASE_URL=sqlite:///./platform.db

# ---------------------------------------------------------------------------
# Authentification
# ---------------------------------------------------------------------------
# IMPORTANT : générez une valeur longue et aléatoire en production
# (>= 32 caractères). Exemple : python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production-please-use-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ---------------------------------------------------------------------------
# Sécurité des scans
# ---------------------------------------------------------------------------
# Garde-fou anti-SSRF : laisser false en production.
# Passer à true uniquement pour scanner localhost / un réseau privé de démo.
ALLOW_PRIVATE_TARGETS=false

# ---------------------------------------------------------------------------
# Limites de scan
# ---------------------------------------------------------------------------
MAX_PAGES_PER_SCAN=20
MAX_LINKS_CHECKED=40
SCAN_TIMEOUT_SECONDS=900
AGENT_TIMEOUT_SECONDS=300
MAX_CONCURRENT_SCANS=3

# ---------------------------------------------------------------------------
# Pondération du score global (la somme est normalisée automatiquement)
# ---------------------------------------------------------------------------
SCORE_WEIGHTS=reliability=0.30,security=0.35,performance=0.20,accessibility=0.15

# ---------------------------------------------------------------------------
# Rapports
# ---------------------------------------------------------------------------
REPORTS_DIR=reports
SCREENSHOTS_DIR=reports/screenshots
REPORTS_URL_PREFIX=/reports
